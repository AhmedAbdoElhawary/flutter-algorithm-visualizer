{
  "overallMin": 80,
  "overallGated": false,
  "logicMin": 90,
  "areaMin": 80,
  "logicFolders": ["data", "domain", "view_model", "helper", "helpers", "storage", "exceptions", "extensions", "enums"],
  "exclude": [
    "**/*.g.dart",
    "lib/main_*.dart",
    "lib/bootstrap.dart",
    "lib/features/auth/data/data_sources/remote/auth_remote_data_source.dart",
    "lib/features/challenge/data/data_sources/remote/challenge_remote_data_source.dart",
    "lib/features/profile/data/data_sources/remote/profile_remote_data_source.dart"
  ],
  "areas": {
    "auth":        { "path": "lib/features/auth/",        "gated": false },
    "base":        { "path": "lib/features/base/",        "gated": false },
    "challenge":   { "path": "lib/features/challenge/",   "gated": false },
    "home":        { "path": "lib/features/home/",        "gated": true },
    "onboarding":  { "path": "lib/features/onboarding/",  "gated": true },
    "profile":     { "path": "lib/features/profile/",     "gated": false },
    "settings":    { "path": "lib/features/settings/",    "gated": false },
    "visualize":   { "path": "lib/features/visualize/",   "gated": false },
    "engine":      { "path": "lib/core/custom_packages/custom_code_editor/src/execution/", "gated": false, "min": 80, "logicMin": 80 },
    "codeEditor":  { "path": "lib/core/custom_packages/", "gated": false },
    "core":        { "path": "lib/core/",                 "gated": false },
    "config":      { "path": "lib/config/",               "gated": false }
  }
}
