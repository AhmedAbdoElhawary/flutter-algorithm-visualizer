# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/*
# ...but keep shared per-flavor run configurations
!.idea/runConfigurations/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
./upload-keystore.jks
# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/upload-keystore.jks
/lib/firebase_options.dart
/.VSCodeCounter/
/firebase.json
/.claude
/android/app/google-services.json
/AGENTS.md
/ios/Runner/GoogleService-Info.plist

# --- Flavors: per-flavor Firebase config (provide locally / inject in CI) ---
# Android google-services plugin reads android/app/src/<flavor>/google-services.json
/android/app/src/dev/google-services.json
/android/app/src/staging/google-services.json
/android/app/src/production/google-services.json
# iOS source plists; ios/scripts/firebase_config.sh copies the right one into
# ios/Runner/GoogleService-Info.plist at build time (that dest is ignored above)
/ios/Runner/Firebase/dev/GoogleService-Info.plist
/ios/Runner/Firebase/staging/GoogleService-Info.plist
/ios/Runner/Firebase/production/GoogleService-Info.plist

# --- Signing (never commit) ---
/android/key.properties
*.jks
*.keystore
# Generated CI keystores + their plaintext secret values (paste into GitHub, then
# move the .jks + passwords to a vault). Never commit this folder.
/ci-keystores/
# App Store / Fastlane
/ios/fastlane/report.xml
/ios/fastlane/Preview.html
/ios/fastlane/*.mobileprovision
/ios/**/*.p12

# --- Flavor icon intermediates (regenerated from base/app_icon.png) ---
# Final icons in android/app/src/*/res and AppIcon-*.appiconset ARE committed.
/tool/flavor_icons/generated/

# --- dart-define ---
# THIS REPO IS PUBLIC. dart_define/*.json hold only non-secret selectors
# (flavor, app name, public base URL) and ARE committed. Anything that must
# not be world-readable goes in a *.secret.json, which is never committed —
# in CI it is written from a GitHub Environment secret and deleted after the
# build. See dart_define/README.md.
/dart_define/*.secret.json

# flutter_dotenv-style env files. Not used here on purpose: .env ships as a
# Flutter asset, so `unzip app.apk` prints it in plaintext. Ignored anyway so
# one can never be committed by accident.
*.env
.env.*
!.env.example

/specs/
/docs/